{
  "name": "orchestra-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "expo:doctor": "npx expo-doctor",
    "expo:prebuild": "expo prebuild",
    "eas:init": "npx eas-cli init",
    "eas:check": "node scripts/eas-preflight.js",
    "eas:credentials": "npx eas-cli credentials",
    "build:android": "npm run eas:check && npx eas-cli build --platform android",
    "build:ios": "npm run eas:check && npx eas-cli build --platform ios",
    "build:web": "expo export --platform web",
    "postinstall": "node scripts/generate-ios-icon.cjs",
    "icons:generate": "node scripts/generate-ios-icon.cjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.45.4",
    "babel-preset-expo": "~54.0.10",
    "expo": "~54.0.37",
    "expo-build-properties": "~1.0.10",
    "expo-font": "~14.0.12",
    "expo-iap": "~3.4.13",
    "expo-notifications": "~0.32.17",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "pngjs": "3.4.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-get-random-values": "~1.11.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/react": "~19.1.10",
    "@types/react-test-renderer": "^19.3.0",
    "jest": "^29.7.0",
    "react-test-renderer": "^19.1.0",
    "ts-jest": "^29.2.5",
    "typescript": "~5.9.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/src/**/__tests__/**/*.test.ts",
      "<rootDir>/src/**/__tests__/**/*.test.tsx"
    ],
    "transform": {
      "^.+\\.[jt]sx?$": [
        "ts-jest",
        {
          "jsx": "react-jsx",
          "allowJs": true,
          "diagnostics": false
        }
      ]
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(react-native-web)/)"
    ],
    "moduleNameMapper": {
      "^react-native$": "react-native-web",
      "^@expo/vector-icons/Feather$": "<rootDir>/src/__mocks__/feather.tsx",
      "^react-native-safe-area-context$": "<rootDir>/src/__mocks__/safeArea.tsx",
      "^expo-notifications$": "<rootDir>/src/__mocks__/expo-notifications.ts",
      "^expo-iap$": "<rootDir>/src/__mocks__/expo-iap.ts",
      "\\.(png|jpe?g|gif|webp|svg)$": "<rootDir>/src/__mocks__/imageAsset.ts"
    }
  }
}
