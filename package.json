{
	"name": "orchestra-mobile",
	"version": "0.1.0",
	"private": true,
	"main": "index.ts",
	"scripts": {
		"start": "expo start",
		"android": "expo start --android",
		"ios": "expo start --ios",
		"web": "expo start --web",
		"typecheck": "tsc --noEmit",
		"test": "jest",
		"expo:doctor": "npx expo-doctor",
		"expo:prebuild": "expo prebuild",
		"eas:init": "npx eas-cli init",
		"eas:check": "node scripts/eas-preflight.js",
		"eas:credentials": "npx eas-cli credentials",
		"build:android": "npm run eas:check && npx eas-cli build --platform android",
		"build:ios": "npm run eas:check && npx eas-cli build --platform ios",
		"build:web": "expo export --platform web"
	},
	"dependencies": {
		"@expo/vector-icons": "14.1.0",
		"@react-native-async-storage/async-storage": "1.23.1",
		"@supabase/supabase-js": "^2.45.4",
		"expo": "~51.0.39",
		"expo-secure-store": "~13.0.2",
		"expo-status-bar": "~1.12.1",
		"react": "18.2.0",
		"react-native": "0.74.5",
		"react-native-get-random-values": "~1.11.0",
		"react-native-safe-area-context": "4.10.5",
		"react-native-url-polyfill": "^2.0.0"
	},
	"devDependencies": {
		"@types/jest": "^29.5.12",
		"@types/react": "~18.2.79",
		"jest": "^29.7.0",
		"ts-jest": "^29.2.5",
		"typescript": "~5.3.3"
	},
	"jest": {
		"preset": "ts-jest",
		"testEnvironment": "node",
		"testMatch": [
			"<rootDir>/src/**/__tests__/**/*.test.ts"
		]
	}
}
